# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
gradle-app.setting
.gradletasknamecache

# Release jars, kept out of build/ so the next build cannot overwrite them
release/

# The source recording of the demo (36 MB); docs/demo.gif is made from it
docs/demo.mp4

# Loader run directories. The Fabric and NeoForge mod projects run the
# canonical Minecraft version in <project>/run/ and any other target in
# <project>/run-mc<version>/ (see fabric/build.gradle and
# neoforge/build.gradle), so a world saved by one game version is never
# opened by another. Their test runs live under build/.
run/
run-mc*/
remappedSrc/
.loom-cache/

# IDE - IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Java
*.class
hs_err_pid*
replay_pid*

# Python (neoforge/tools/gen_empty_structure.py is meant to be rerun)
__pycache__/
*.pyc

# Crash dumps of Git for Windows' own tools
*.stackdump
